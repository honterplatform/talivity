# --- LLM API keys -----------------------------------------------------------
# Any provider without a key (or that runs out of credits) is skipped
# automatically; audits run on whichever providers are available.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Studio key for Gemini (GEMINI_API_KEY also works)
GOOGLE_AI_API_KEY=

# Optional model overrides — change these when a provider retires a model,
# no code deploy needed.
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.8-flash

# Which provider runs the internal helper steps (company profile + answer
# analysis). Claude first by default; the others are fallbacks.
# HELPER_PROVIDERS=anthropic,openai,gemini

# --- Database ---------------------------------------------------------------
# Local: mongodb://localhost:27017/talivity-audit
# Railway: auto-injected by the MongoDB plugin as MONGO_URL
MONGO_URL=

# Public app URL — used for absolute links / og tags.
NEXT_PUBLIC_APP_URL=http://localhost:8080

# --- Admin panel (HTTP Basic Auth at /admin) -----------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Rate limiting (on by default; every audit costs ~20–30 LLM calls) --------
# Set to true while testing.
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_PER_EMAIL_PER_HOUR=3
# RATE_LIMIT_PER_IP_PER_HOUR=10
# RATE_LIMIT_GLOBAL_PER_DAY=500
# IP_HASH_SALT=change-me

# How many audits run at once per server; the rest wait in line.
# AUDIT_MAX_CONCURRENCY=4

# --- Links (inlined at build time) --------------------------------------------
# "Book a call" on the thanks page. Defaults to https://talivity.com/contact
# NEXT_PUBLIC_BOOKING_URL=
# NEXT_PUBLIC_PRIVACY_URL=https://talivity.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://talivity.com/terms
# NEXT_PUBLIC_CONTACT_URL=https://talivity.com/contact
